# Runtime
NODE_ENV=development
TZ=Asia/Seoul
LOG_LEVEL=info

# Local paths
FMINDEX_DATA_DIR=./data
FMINDEX_LOG_DIR=./logs
FMINDEX_DB_URL=file:./data/fmindex.sqlite

# Collector safety defaults
COLLECTOR_ENABLED=false
COLLECTOR_SOURCE=fmkorea-stock
COLLECTOR_LIST_INTERVAL_SECONDS=600
COLLECTOR_DETAIL_CONCURRENCY=1
COLLECTOR_MIN_REQUEST_DELAY_MS=3000
COLLECTOR_MAX_REQUEST_DELAY_MS=7000
COLLECTOR_HTTP_TIMEOUT_MS=20000
COLLECTOR_MAX_RETRIES=2
COLLECTOR_BACKOFF_BASE_MS=30000
COLLECTOR_STOP_ON_429=true
COLLECTOR_RAW_RETENTION_DAYS=7

# Local LLM provider. Keep provider-specific secrets outside Git.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local-only
LLM_MODEL=
LLM_TIMEOUT_MS=120000
LLM_MAX_CONCURRENCY=1

# Analysis versions
ANALYSIS_SCHEMA_VERSION=sentiment.v1
PROMPT_VERSION=fmindex-ko-v1
INDEX_FORMULA_VERSION=index-v0

# Public application
API_HOST=127.0.0.1
API_PORT=4310
WEB_PORT=4320
PUBLIC_DATA_DELAY_MINUTES=15

# Market data is disabled until a licensed/approved source is selected.
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
